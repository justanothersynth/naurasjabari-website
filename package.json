  },
  "engines": {
    "node": ">=22.14"
  },
  "homepage": "https://github.com/justanothersynth/naurasjabari-website#readme",
  "keywords": [],
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "lint": "FORCE_COLOR=1 bun run --elide-lines 0 --filter '!@workspace/_deprecated' lint",
    "ts-check": "FORCE_COLOR=1 bun run --elide-lines 0 --filter '!@workspace/_deprecated' ts-check",
    "review": "bun run lint && bun run ts-check",
    "test": "FORCE_COLOR=1 bun run --elide-lines 0 --filter '@package/utils' --filter '@service/crons' test",
    "test:coverage": "FORCE_COLOR=1 bun run --elide-lines 0 --filter '@package/utils' --filter '@service/crons' test:coverage",
    "prepare": "husky"
  },
  "workspaces": [
    "packages/types",
    "packages/utils",
    "services/api",
    "services/client",
    "services/crons"
  ],
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "vitest": "^4.0.17",
    "husky": "^9.1.7",
    "@types/bun": "^1.3.8",
    "@types/node": "^25.0.9",
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1"
  }
}
